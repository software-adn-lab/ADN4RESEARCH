[flake8]
# Keep lines reasonably long but ignore line-too-long errors (E501) explicitly
max-line-length = 100

# Common style conflicts with black/other formatters
extend-ignore = E203, W503

# Ignore docstring checks (D1xx from pydocstyle / flake8-docstrings) and E501
ignore = D100,D101,D102,D103,D104,D105,D106,E501,D200,D205,D204,D107,E402,D401,D400

exclude = .git,__pycache__,env,venv,.venv,build,dist

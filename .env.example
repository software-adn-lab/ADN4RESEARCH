# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# Django Secret Key (CHANGE THIS IN PRODUCTION!)
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-oxq-k)&z4v0ip6rtm)3c%44(-7q1@_ddfsk41+_)yg6zo9zo3i

# Debug Mode (MUST be False in production)
DEBUG=True

# Allowed Hosts (comma-separated, no spaces)
# Example: localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Django Port (only for local development without Docker)
DJANGO_PORT=8000


# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# You can either provide a single DATABASE_URL (recommended) or the DB_* vars below.
# Examples:
#   Postgres: postgres://USER:PASSWORD@HOST:PORT/NAME
#   SQLite absolute: sqlite:////absolute/path/to/db.sqlite3
#   SQLite relative: sqlite:///db.sqlite3
# Example concrete (Postgres local):
# DATABASE_URL=postgres://postgres:secret@localhost:5432/adn4research
# Example concrete (SQLite relative):
# DATABASE_URL=sqlite:///db.sqlite3

DB_NAME=adn4research
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# For Docker: Change DB_HOST to 'db' (service name in docker-compose.yml)
# DB_HOST=db


# =============================================================================
# REDIS CONFIGURATION (Caching & Message Broker)
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# For Docker: Change REDIS_HOST to 'redis' (service name in docker-compose.yml)
# REDIS_HOST=redis


# =============================================================================
# CELERY CONFIGURATION (Async Tasks)
# =============================================================================

# Celery uses Redis configuration from above (REDIS_HOST, REDIS_PORT, etc.)
# No additional configuration needed


# =============================================================================
# STORAGE CONFIGURATION (S3-Compatible: MinIO, AWS S3, etc.)
# =============================================================================

# Use S3 storage? (True/False)
USE_S3=False

# MinIO Configuration (for local development with Docker)
# If using MinIO via Docker, uncomment these:
# USE_S3=True
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_STORAGE_BUCKET_NAME=adn4research
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_VERIFY=False

# MinIO Ports
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS S3 Configuration (for production)
# Uncomment and configure if using real AWS S3:
# USE_S3=True
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=your-cloudfront-domain.cloudfront.net
# AWS_S3_VERIFY=True


# =============================================================================
# DOCKER-SPECIFIC SETTINGS
# =============================================================================

# When using Docker, uncomment these overrides:
# DB_HOST=db
# REDIS_HOST=redis
# AWS_S3_ENDPOINT_URL=http://minio:9000


# =============================================================================
# EMAIL CONFIGURATION (Optional)

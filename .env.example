# =============================================================================
# ACQUISITION MODULE - WEB SCRAPING CREDENTIALS
# =============================================================================

# Credenciales institucionales EPN (para IEEE Xplore y Scopus vía EZproxy)
#
# FUNCIONAMIENTO:
# 1. Si estás EN LA RED de la universidad: Acceso automático por IP (no necesita credenciales)
# 2. Si estás FUERA de la red: Login automático con estas credenciales vía Playwright
#
# IMPORTANTE:
# - Estas credenciales se usan SOLO cuando no estás en la red universitaria
# - NUNCA commitear .env con credenciales reales
# - Para producción: usar credenciales del laboratorio ADN Software
EPN_USER=tu.correo@epn.edu.ec
EPN_PASS=tu_contraseña_aqui

# API Keys para bases de datos académicas
# -----------------------------------------

# Scopus API Key (Elsevier Developer Portal)
# Obtener en: https://dev.elsevier.com/
# Cuota gratuita: 20,000 búsquedas/semana
SCOPUS_API_KEY=tu_api_key_aqui

# Scopus Preloaded Cookies (Opcional - EVITA reCAPTCHA en Playwright)
# -----------------------------------------------------------------------
# Si trabajas FUERA de la red EPN y Playwright es bloqueado por reCAPTCHA,
# puedes exportar las cookies de tu sesión autenticada manualmente:
#
# PASOS PARA EXPORTAR COOKIES:
# 1. Abrir Chrome/Edge en modo normal (NO incógnito)
# 2. Ir a https://bvirtual.epn.edu.ec/login?url=http://www.scopus.com/
# 3. Hacer login manualmente (resolver reCAPTCHA)
# 4. Abrir DevTools (F12) → Tab "Application" → "Cookies"
# 5. Copiar todas las cookies del dominio "bvirtual.epn.edu.ec"
# 6. Formatear como JSON array (ver ejemplo abajo)
# 7. Pegar en esta variable (todo en una línea, sin saltos)
#
# FORMATO JSON (ejemplo - reemplazar con tus cookies reales):
# SCOPUS_COOKIES=[{"name":"ezproxy","value":"xxx","domain":".bvirtual.epn.edu.ec","path":"/"},{"name":"SCSessionID","value":"yyy","domain":".scopus.com","path":"/"}]
#
# IMPORTANTE:
# - Las cookies expiran (típicamente 24h). Renovar si Playwright falla.
# - NUNCA commitear .env con cookies reales (están en .gitignore)
# - Si trabajas EN LA RED de la EPN, no necesitas cookies (acceso automático por IP)
#
# SCOPUS_COOKIES=

# Unpaywall Email (requerido para usar API de Unpaywall)
# Unpaywall requiere un email válido en los requests
# API gratuita, sin límites estrictos
UNPAYWALL_EMAIL=tu.correo@epn.edu.ec

# Directorio para almacenar PDFs descargados
# Default: media/papers
PAPERS_STORAGE_DIR=media/papers


# =============================================================================
# FUENTES ALTERNATIVAS (OPCIONAL)
# =============================================================================

# ⚠️  AVISO LEGAL IMPORTANTE:
# LibGen y Sci-Hub operan en zona gris legal. Su uso puede violar leyes de copyright.
# Solo usar para investigación académica personal.
# Verificar leyes locales antes de habilitar.

# Habilitar LibGen y Sci-Hub como fuentes alternativas (True/False)
# Default: False (DESHABILITADO)
#
# CASCADA DE DESCARGAS:
# 1. Hint desde Discovery (IEEE/Scopus OA)
# 2. Unpaywall (gratuito, legal)
# 3. Crossref (gratuito, legal)
# 4. Scopus API (institucional)
# 5. LibGen (zona gris, solo si ENABLE_SCIHUB=true)
# 6. Sci-Hub (zona gris, solo si ENABLE_SCIHUB=true)
# 7. Marcar como no_disponible (carga manual)
ENABLE_SCIHUB=false


# =============================================================================
# INTERPRETATION MODULE - LLM CONFIGURATION
# =============================================================================

# LLM Backend for Interpretative Assistance
# Options: 'default' (mock/placeholder), 'gemini'
# If 'default', no external API calls are made (useful for testing)
# If 'gemini', requires GEMINI_API_KEY to be set
INTERPRETATION_LLM=default

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Required only if INTERPRETATION_LLM=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-flash-latest


# =============================================================================
# NOTES
# =============================================================================

# LOCAL DEVELOPMENT (without Docker):
# - Keep DB_HOST=localhost, REDIS_HOST=localhost
# - Install PostgreSQL, Redis locally
# - Set USE_S3=False to use local media storage

# DOCKER DEVELOPMENT:
# - Change DB_HOST=db, REDIS_HOST=redis
# - Set USE_S3=True with MinIO configuration
# - Run: docker-compose up -d

# PRODUCTION:
# - Set DEBUG=False
# - Change SECRET_KEY to a secure random value
# - Configure real PostgreSQL, Redis instances
# - Use AWS S3 or cloud storage
# - Set proper ALLOWED_HOSTS
